# ==========================================
# AegisRAG - Sensitive Data Protection
# ==========================================

# 1. Environment secrets
.env
.env.*
!.env.example

# 2. Private credentials and certificates
secrets/
credentials/
*.key
*.pem
*.cert
*.p12
*.pfx
service-account*.json
*-credentials*.json

# 3. Local databases
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# 4. Database backups
data/backups/
backups/
*.bak
*.backup

# 5. Security audit logs and application logs
*.log
data/logs/
logs/

# 6. Private uploaded documents
data/raw_documents/*
!data/raw_documents/.gitkeep

# 7. Quarantined documents
data/quarantine_vault/*
!data/quarantine_vault/.gitkeep

# 8. Local ChromaDB storage
data/chroma_db/
chroma_db/
chroma_data/

# 9. Large transformer model weights
*.safetensors

# ==========================================
# END
# ==========================================
