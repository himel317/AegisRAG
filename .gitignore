# ==========================================================
# AEGISRAG - PRODUCTION-ORIENTED GIT IGNORE
# ==========================================================


# ----------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & APPLICATION SECRETS
# ----------------------------------------------------------

.env
.env.*
!.env.example

# Secret and credential directories
secrets/
credentials/

# API keys and private credentials
*.key
*.pem
*.p12
*.pfx

# Service account credentials
service-account*.json
*-credentials*.json


# ----------------------------------------------------------
# 2. PYTHON ENVIRONMENT & CACHE
# ----------------------------------------------------------

venv/
.venv/
env/
ENV/
backend/venv/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ----------------------------------------------------------
# 3. NODE.JS & FRONTEND DEPENDENCIES
# ----------------------------------------------------------

node_modules/
frontend/node_modules/

.npm/
dist/
build/
frontend/dist/


# ----------------------------------------------------------
# 4. LOCAL DATABASE & USER DATA
# ----------------------------------------------------------

*.db
*.sqlite
*.sqlite3

# AegisRAG runtime database
data/sqlite.db

# Local user-uploaded documents
data/raw_documents/

# Quarantined documents
data/quarantine_vault/

# Local vector database
data/chroma_db/

# Local ChromaDB storage
chroma_db/
chroma_data/

# User-specific uploads
uploads/
user_uploads/


# ----------------------------------------------------------
# 5. SECURITY AUDIT LOGS & APPLICATION LOGS
# ----------------------------------------------------------

*.log
logs/

data/security_audit.log
data/logs/


# ----------------------------------------------------------
# 6. BACKUPS & TEMPORARY FILES
# ----------------------------------------------------------

*.bak
*.backup
*.old
*.tmp

tmp/
temp/
backups/


# ----------------------------------------------------------
# 7. MACHINE LEARNING CACHE
# ----------------------------------------------------------

.cache/
.huggingface/
.transformers_cache/

# Downloaded model caches
model_cache/
models_cache/


# ----------------------------------------------------------
# 8. TEST & COVERAGE ARTIFACTS
# ----------------------------------------------------------

.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/


# ----------------------------------------------------------
# 9. IDE & OPERATING SYSTEM FILES
# ----------------------------------------------------------

.vscode/
.idea/

.DS_Store
Thumbs.db
Desktop.ini


# ----------------------------------------------------------
# END OF AEGISRAG GIT IGNORE
# ==========================================================
