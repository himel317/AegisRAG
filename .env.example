# ==============================================================================
# AEGISRAG FRAMEWORK - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file and rename the copy to .env.
# 2. Configure the values for your local environment.
# 3. Add your own Gemini API key if required.
# 4. Never commit your actual .env file to GitHub.
#
# IMPORTANT:
# This file contains example configuration only.
# Never place real credentials or secrets in this file.
# ==============================================================================


# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------

APP_NAME="AegisRAG Framework"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

API_V1_PREFIX=/api/v1

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]


# ------------------------------------------------------------------------------
# Database Configuration - SQLite
# ------------------------------------------------------------------------------

DATABASE_URL=sqlite+aiosqlite:///./data/sqlite.db
DATABASE_SYNC_URL=sqlite:///./data/sqlite.db


# ------------------------------------------------------------------------------
# Vector Store Configuration - ChromaDB
# ------------------------------------------------------------------------------

CHROMA_PERSIST_DIRECTORY=./data/chroma_db

CHROMA_COLLECTION_TRUSTED=trusted_documents
CHROMA_COLLECTION_QUARANTINE=quarantine_documents


# ------------------------------------------------------------------------------
# Embeddings Model Configuration
# ------------------------------------------------------------------------------

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu


# ------------------------------------------------------------------------------
# Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Optional: Offline RAG mode may be available when the API key is empty.
# Configure your own API key locally when Gemini integration is required.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048


# ------------------------------------------------------------------------------
# Security Decision Engine Thresholds
# ------------------------------------------------------------------------------

SECURITY_POLICY_MODE=balanced

PROMPT_INJECTION_THRESHOLD=0.65
DATA_POISONING_THRESHOLD=0.60
QUARANTINE_AUTO_TRIGGER_THRESHOLD=0.75


# ------------------------------------------------------------------------------
# File Upload & Quarantine Vault Storage
# ------------------------------------------------------------------------------

UPLOAD_STORAGE_DIR=./data/raw_documents
QUARANTINE_STORAGE_DIR=./data/quarantine_vault

MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS=["pdf","txt","md"]


# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------

LOG_LEVEL=INFO
ENABLE_DETAILED_AUDIT_LOG=true

AUDIT_LOG_FILE=./data/security_audit.log


# ==============================================================================
# END OF AEGISRAG CONFIGURATION TEMPLATE
# ==============================================================================
